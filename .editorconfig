# https://editorconfig.org/
# https://github.com/editorconfig/editorconfig/wiki/EditorConfig-Properties

# Defaults
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

# Languages

# Dockerfile
[**/*Dockerfile*]
indent_size = 4

# Markdown
[**/*.md]
indent_size = 4

# Shell
[**/*.{bash,sh}]
indent_size = 4
